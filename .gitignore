# ─── local-only docs ──────────────────────────────────────────────────────
# The runbook holds real hostnames, IPs and provider details. The public README
# documents the same procedures without them.
RUNBOOK.local.md
*.local.md

# ─── secrets ──────────────────────────────────────────────────────────────
# This repo carries deploy config that references TLS material by path. A key
# or cert must never end up in here by accident.
*.pem
*.key
*.crt
*.p12
*.pfx
.env
.env.*
!.env.example
secrets/

# ─── verification artefacts ───────────────────────────────────────────────
# Screenshots are regenerated from the live pages; committing them would add
# megabytes of noisy binary diffs on every visual tweak.
screenshots/
.preview/
.shot/
*.png.tmp

# ─── local tooling ────────────────────────────────────────────────────────
# The site itself has no build step, but scratch scripts turn up alongside it.
node_modules/
package-lock.json.bak
npm-debug.log*
yarn-error.log*
__pycache__/
*.py[cod]
.venv/
venv/
.cache/

# ─── logs & temp ──────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
*.rej

# ─── editors ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sw[np]
*~
.\#*
\#*\#

# ─── OS cruft ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
